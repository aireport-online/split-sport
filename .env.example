# Copy to apps/api/.env for local development.

# Port of the API (and, in production, the web app).
PORT=8787

# SQLite database file. The directory is created when it does not exist.
DATABASE_PATH=./data/split.db

# Receipt scanning uses Claude. Without a key the app works; only "Bon scannen" is hidden.
# ANTHROPIC_API_KEY=
# RECEIPT_MODEL=claude-opus-5-5

# Set to 1 behind a reverse proxy that sets X-Forwarded-For (rate limiting per client address).
# TRUST_PROXY=1

# Directory of the built web app. Defaults to ../web/dist, which is right for `pnpm start`.
# WEB_DIST=

# Only when a browser app on another origin must call the API.
# CORS_ORIGIN=
