{
  "name": "split",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @split/api --filter @split/web dev",
    "build": "pnpm --filter @split/web build && pnpm --filter @split/api build",
    "start": "pnpm --filter @split/api start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
